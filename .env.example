# PostgreSQL connection string used by Drizzle ORM (src/db) and drizzle-kit.
#
# Local development (optional — app runs with dummy data without it):
DATABASE_URL="postgres://user:password@localhost:5432/project_admin_center"

# Production on Vercel uses Neon (https://neon.tech). Copy the connection string
# from the Neon dashboard. Use the POOLED string (host contains `-pooler`) for
# the serverless app runtime — the client auto-detects it and disables prepared
# statements, and enables SSL automatically:
#
#   DATABASE_URL="postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
#
# For running migrations (`npx drizzle-kit migrate`) either the pooled or the
# direct (non-pooler) string works; the direct one is slightly faster for DDL.
